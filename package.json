{
  "name": "formo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "test:unit": "tsx --test tests/submission-policy.test.ts tests/template-design.test.ts tests/template-studio.test.ts",
    "test:pipeline": "vitest run",
    "test:e2e": "tsx scripts/e2e-submission.ts",
    "test:e2e:maintenance": "tsx scripts/e2e-maintenance.ts",
    "test:e2e:recipients": "tsx scripts/e2e-recipients.ts",
    "clean": "rmdir /s /q .next",
    "check": "npm run lint && tsc --noEmit && vitest run",
    "security": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@prisma/adapter-neon": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.3.1",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-link": "^3.34.0",
    "@tiptap/extension-placeholder": "^3.34.0",
    "@tiptap/extension-text-align": "^3.34.0",
    "@tiptap/extension-text-style": "^3.34.0",
    "@tiptap/extension-underline": "^3.34.0",
    "@tiptap/html": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@vercel/analytics": "^2.0.1",
    "better-auth": "^1.7.25",
    "dotenv": "^18.0.10",
    "lucide-react": "^1.73.0",
    "next": "^16.4.6",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "^2.18.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
