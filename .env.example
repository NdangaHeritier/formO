# Runtime Environment
NODE_ENV="development"

# ---------------------------------------------------------------------------
# Database — local Postgres by default, Neon in production
# ---------------------------------------------------------------------------
# LOCAL DEVELOPMENT: keep this as-is. It uses the plain `pg` driver.
# Optional explicit connection string for FormO. Set this when the host injects
# its own DATABASE_URL (for example a Prisma Accelerate pris:// URL).
FORMO_DATABASE_URL=
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/formo?schema=public"

# PRODUCTION (Neon): set DATABASE_URL to the POOLED connection string
# (the hostname contains "-pooler"). Add connect_timeout so a scaled-to-zero
# compute has time to wake up:
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/formo?sslmode=require&channel_binding=require&connect_timeout=15"
#
# Also set the DIRECT (unpooled) string for `prisma migrate deploy` — remove
# "-pooler" from the hostname. Prisma CLI needs a direct connection for DDL:
# DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxx.region.aws.neon.tech/formo?sslmode=require&channel_binding=require"
#
# Optional: force the driver when Neon sits behind a custom domain.
# "auto" (default) detects Neon by the .neon.tech hostname.
# DATABASE_DRIVER="auto"   # auto | neon | pg

# Better Auth (added in M3; generate 32+ char secrets via: openssl rand -hex 32)
BETTER_AUTH_SECRET="replace-with-at-least-32-character-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
# Comma-separated additional browser origins trusted by better-auth.
TRUSTED_ORIGINS=""

# FormO Secrets Encryption & Hashing (added in M5/M6)
FORMO_ENCRYPTION_KEY="replace-with-at-least-32-character-random-secret"
FORMO_HMAC_PEPPER="replace-with-at-least-32-character-random-secret"
# Optional keyring for rotating the encryption key: {"1":"<old key>","2":"<new key>"}
# When set, it is authoritative — list every version still used by stored rows.
# FORMO_ENCRYPTION_KEYS='{"1":"replace-with-at-least-32-character-key"}'

# Public intake limits and retention
# FORMO_RATE_LIMIT_PER_CLIENT=10   # per (form, IP) per minute
# FORMO_RATE_LIMIT_PER_FORM=600    # per form across all clients per minute
# FORMO_SUBMISSION_RETENTION_DAYS=  # unset keeps submissions forever

# Default System SMTP (Nodemailer / Mailpit local dev)
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="FormO <noreply@localhost>"

# Maintenance & Spam Protection
# Required in production (32+ characters). Guards /api/cron/* Bearer auth.
CRON_SECRET=""
TURNSTILE_SECRET_KEY=
# GitHub OAuth app credentials (both required to enable GitHub sign-in).
# Authorization callback URL: {BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google OAuth client credentials (both required to enable Google sign-in).
# Authorization callback URL: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=""

# Number of trusted reverse-proxy hops in X-Forwarded-For.
# 0 (default) ignores the header entirely; clients can spoof it.
TRUSTED_PROXY_HOPS="0"

# Months of range partitions the maintenance job keeps ahead (2-24, default 6).
PARTITION_MONTHS_AHEAD="6"

# LOCAL DEVELOPMENT ONLY. Enables built-in fallback encryption/HMAC keys.
# Never set this in production. Leave commented out normally.
# FORMO_ALLOW_DEV_SECRETS="1"

# LOCAL DEVELOPMENT ONLY. Allows loopback SMTP hosts (e.g. a mail sink on 1025).
# Never set this in production; the SSRF guard rejects all non-public hosts.
# FORMO_ALLOW_LOCAL_SMTP="true"
