# Runtime Environment
NODE_ENV="development"

# PostgreSQL 18 Connection
# Local Windows PostgreSQL 18 or Docker Compose postgres service:
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/formo?schema=public"

# Better Auth (added in M3; generate 32+ char secrets via: openssl rand -hex 32)
BETTER_AUTH_SECRET="replace-with-at-least-32-character-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# FormO Secrets Encryption & Hashing (added in M5/M6)
FORMO_ENCRYPTION_KEY="replace-with-at-least-32-character-random-secret"
FORMO_HMAC_PEPPER="replace-with-at-least-32-character-random-secret"

# Default System SMTP (Nodemailer / Mailpit local dev)
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="FormO <noreply@localhost>"

# Optional Maintenance & Spam Protection
CRON_SECRET=""
TURNSTILE_SECRET_KEY=""
