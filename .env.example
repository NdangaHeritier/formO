# Runtime Environment
NODE_ENV="development"

# PostgreSQL 18 Connection
# Local Windows PostgreSQL 18 or Docker Compose postgres service:
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/formo?schema=public"

# Better Auth (added in M3; generate 32+ char secrets via: openssl rand -hex 32)
BETTER_AUTH_SECRET="replace-with-at-least-32-character-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
# Comma-separated additional browser origins trusted by better-auth.
TRUSTED_ORIGINS=""

# FormO Secrets Encryption & Hashing (added in M5/M6)
FORMO_ENCRYPTION_KEY="replace-with-at-least-32-character-random-secret"
FORMO_HMAC_PEPPER="replace-with-at-least-32-character-random-secret"

# Default System SMTP (Nodemailer / Mailpit local dev)
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="FormO <noreply@localhost>"

# Maintenance & Spam Protection
# Required in production (32+ characters). Guards /api/cron/* Bearer auth.
CRON_SECRET=""
TURNSTILE_SECRET_KEY=""

# Number of trusted reverse-proxy hops in X-Forwarded-For.
# 0 (default) ignores the header entirely; clients can spoof it.
TRUSTED_PROXY_HOPS="0"

# Months of range partitions the maintenance job keeps ahead (2-24, default 6).
PARTITION_MONTHS_AHEAD="6"

# LOCAL DEVELOPMENT ONLY. Enables built-in fallback encryption/HMAC keys.
# Never set this in production. Leave commented out normally.
# FORMO_ALLOW_DEV_SECRETS="1"

# LOCAL DEVELOPMENT ONLY. Allows loopback SMTP hosts (e.g. a mail sink on 1025).
# Never set this in production; the SSRF guard rejects all non-public hosts.
# FORMO_ALLOW_LOCAL_SMTP="true"
